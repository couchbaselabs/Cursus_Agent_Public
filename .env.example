# Copy to .env and fill in before running `docker compose up`

# Supportal session cookie — optional, can be pasted in Strabo UI instead.
# Get it from DevTools → Network → any request → Headers → Cookie.
SUPPORTAL_COOKIE=

# Corax (Chainlit) JWT auth secret.
# Auto-generated on first run if not set — set this to keep sessions valid
# across container restarts.
CHAINLIT_AUTH_SECRET=

# ── Couchbase ─────────────────────────────────────────────────────────────────
# Credentials set by couchbase-init on first run.
# After init, configure the same values in Strabo → Configuration → Couchbase.
CB_USER=Administrator
CB_PASS=

# Bucket name — default matches the app's built-in default.
CB_BUCKET=supportal

# Service RAM quotas (MB). Adjust if your host has limited memory.
CB_RAMSIZE=1024          # data service
CB_INDEX_RAMSIZE=512     # index service (GSI)
CB_FTS_RAMSIZE=512       # full-text search service
CB_BUCKET_RAMSIZE=256    # bucket allocation (subset of CB_RAMSIZE)

# ── LLM provider ──────────────────────────────────────────────────────────────
# Configure ONE (cloud key or local endpoint). Powers scoring, vector search,
# and the in-app assistant. Local endpoints can also be set in Strabo → Config.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local (LMStudio :1234 / Ollama :11434) — endpoint goes in the Strabo profile.

# ── Salesforce (required for the SFDC / SE tools) ─────────────────────────────
# Connected-App client-credentials OAuth. sfdc_user_id / sfdc_user_name are set
# in the Strabo profile (~/.supportal_settings.json), not here.
SFDC_TOKEN_HOST=https://couchbase.my.salesforce.com
SFDC_CONSUMER_KEY=
SFDC_CONSUMER_SECRET=
SFDC_AUTH_FLOW=client_credentials

# See docs/prerequisites.md for every dependency + what breaks if missing,
# and the external LLM-client connectors (Gmail, Drive, Jira, Slack) you enable
# in Claude / your MCP host rather than here.
