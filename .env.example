# Copy to .env and fill in before running `docker compose up`

# Supportal session cookie — optional, can be pasted in Strabo UI instead.
# Get it from DevTools → Network → any request → Headers → Cookie.
SUPPORTAL_COOKIE=

# Corax (Chainlit) JWT auth secret.
# Auto-generated on first run if not set — set this to keep sessions valid
# across container restarts.
CHAINLIT_AUTH_SECRET=

# ── Couchbase ─────────────────────────────────────────────────────────────────
# Credentials set by couchbase-init on first run.
# After init, configure the same values in Strabo → Configuration → Couchbase.
CB_USER=Administrator
CB_PASS=

# Bucket name — default matches the app's built-in default.
CB_BUCKET=supportal

# Service RAM quotas (MB). Adjust if your host has limited memory.
CB_RAMSIZE=1024          # data service
CB_INDEX_RAMSIZE=512     # index service (GSI)
CB_FTS_RAMSIZE=512       # full-text search service
CB_BUCKET_RAMSIZE=256    # bucket allocation (subset of CB_RAMSIZE)
